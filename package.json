{
  "name": "stellar-hd-wallet",
  "version": "2.0.0",
  "description": "Key derivation for Stellar (SEP-0005)",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20.19"
  },
  "author": "Chris Hatch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chatch/stellar-hd-wallet.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "lib/stellar-hd-wallet.js",
  "types": "lib/stellar-hd-wallet.d.ts",
  "exports": {
    ".": {
      "types": "./lib/stellar-hd-wallet.d.ts",
      "import": "./lib/stellar-hd-wallet.js",
      "default": "./lib/stellar-hd-wallet.js"
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "test": "mocha",
    "build": "tsc",
    "clean": "rimraf lib",
    "lint": "pnpm lint:eslint && pnpm lint:prettier",
    "lint:eslint": "eslint '**/*.{ts,tsx,js,jsx}' --ignore-pattern '**/eslint.config.js'",
    "lint:prettier": "prettier '**/*.{ts,tsx,js,jsx,json,md,yaml,yml}' --check || echo '⚠️  Warning: Prettier formatting issues found. Run \"pnpm fixstyle\" to fix them.'",
    "typecheck": "tsc --noEmit",
    "fixall": "pnpm fixstyle && pnpm fixsrc",
    "fixsrc": "eslint '**/*.{ts,tsx,js,jsx}' --ignore-pattern '**/eslint.config.js' --fix",
    "fixstyle": "prettier '**/*.{ts,tsx,js,jsx,json,md,yaml,yml}' --write",
    "sbom": "pnpm sbom --sbom-format cyclonedx --lockfile-only --out stellar-hd-wallet-%v.sbom.cdx.json",
    "sbom:spdx": "pnpm sbom --sbom-format spdx --lockfile-only --out stellar-hd-wallet-%v.spdx.json",
    "prepare": "husky",
    "prepublishOnly": "pnpm clean && pnpm build"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,json,md,yaml,yml}": [
      "pnpm fixstyle",
      "pnpm run lint:eslint"
    ]
  },
  "keywords": [
    "SEP-0005",
    "SLIP-0010",
    "BIP-0039",
    "BIP-0044",
    "ed25519",
    "stellar",
    "cryptocurrencies",
    "keys"
  ],
  "dependencies": {
    "@noble/ed25519": "^3.2.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "bip39": "^3.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "mocha": "^12.0.3",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
